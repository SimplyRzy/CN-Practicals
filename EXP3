# Manchester Encoding Program
binary_data = input("Enter Binary Data: ")
encoded_data = ""
for bit in binary_data:
 if bit == '0':
 encoded_data += "10"
 elif bit == '1':
 encoded_data += "01"
 else:
 print("Invalid Input! Please enter only 0 and 1.")
 exit()
print("\nOriginal Binary Data :", binary_data)
print("Manchester Encoded Data:", encoded_data)
